# ─── BASE DE DATOS ────────────────────────────────────────────────────────────
# Desarrollo local (ruta absoluta en Windows):
DATABASE_URL="file:C:/ruta/absoluta/al/proyecto/prisma/dev.db"

# Producción en Render (disco persistente montado en /var/data):
# DATABASE_URL="file:/var/data/prod.db"

# ─── AUTENTICACIÓN ────────────────────────────────────────────────────────────
# Clave secreta para JWT (mínimo 32 caracteres, generá una random para producción)
JWT_SECRET="tu-clave-secreta-aqui-minimo-32-caracteres"

# ─── WHATSAPP ─────────────────────────────────────────────────────────────────
# Código de país + número sin +, espacios ni guiones
WHATSAPP_PHONE_NUMBER="5491100000000"

# ─── SITIO ────────────────────────────────────────────────────────────────────
# URL pública completa (sin barra final)
# Desarrollo: http://localhost:3000
# Producción: https://tu-app.onrender.com (o tu dominio custom)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

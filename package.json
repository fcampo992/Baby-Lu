    "@prisma/client": "^5.22.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^16.3.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "quiet": "^0.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "fast-check": "^3.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  },
  "allowScripts": {
